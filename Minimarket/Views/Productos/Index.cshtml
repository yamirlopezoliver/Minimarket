@model IEnumerable<Minimarket.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Ropa";
    Func<string, string> GetBadgeClass = categoria =>
        categoria?.ToLower() switch
        {
            "hombre" => "badge badge-primary",
            "mujer" => "badge badge-danger",
            "unisex" => "badge badge-success",
            _ => "badge badge-secondary"
        };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #f9f9f9;
        }

        .card:hover {
            transform: scale(1.02);
            transition: transform 0.2s;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .badge {
            font-size: 0.7rem;
            padding: 0.4em 0.6em;
        }

        .badge-position {
            position: absolute;
            top: 0.5rem;
            left: 0.5rem;
            z-index: 1;
        }

        .card-img-top {
            height: 180px;
            object-fit: cover;
            border-top-left-radius: 0.5rem;
            border-top-right-radius: 0.5rem;
        }

        .sold-out-ribbon {
            position: absolute;
            top: 10px;
            right: -30px;
            width: 120px;
            background: linear-gradient(135deg, #ff1744, #d50000);
            color: white;
            text-align: center;
            font-size: 0.8rem;
            font-weight: bold;
            transform: rotate(45deg);
            z-index: 3;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            padding: 5px 0;
            border: 1px solid #fff;
            text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.6);
            letter-spacing: 0.5px;
        }

        .card.sold-out {
            filter: grayscale(90%) brightness(85%);
            opacity: 0.85;
            position: relative;
        }

            .card.sold-out .card-footer .btn {
                pointer-events: none;
                background-color: #bbb !important;
                border-color: #bbb !important;
                color: #fff !important;
            }

        .card-body h6 {
            min-height: 40px;
        }

        .no-results {
            text-align: center;
            color: #888;
            margin-top: 50px;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid py-5 px-4">
        <h1 class="text-center mb-4 text-dark">@ViewData["Title"]</h1>

        <form asp-action="Index" method="get" class="mb-5">
            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                </div>
                <input type="text" name="searchString" class="form-control border-0" placeholder="🔍 Buscar ropa..." value="@ViewData["CurrentFilter"]" />
                <div class="input-group-append">
                    <button class="btn btn-dark" type="submit">Buscar</button>
                </div>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="no-results">
                <i class="bi bi-emoji-frown" style="font-size: 2rem;"></i><br />
                No se encontraron productos.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    var isSoldOut = item.Stock == 0;
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6 mb-4">
                        <div class="card h-100 shadow-sm border-0 @(isSoldOut ? "sold-out" : "")">
                            <span class="@GetBadgeClass(item.Categoria) badge-position text-uppercase">@item.Categoria</span>

                            @if (isSoldOut)
                            {
                                <div class="sold-out-ribbon">AGOTADO</div>
                            }

                            <img src="@Url.Content("~/image/" + (string.IsNullOrEmpty(item.Imagen) ? "imagen-por-defecto.jpg" : item.Imagen))"
                                 alt="@item.Nombre" class="card-img-top" />

                            <div class="card-body text-center">
                                <h6 class="card-title font-weight-medium mb-1 text-dark">@item.Nombre</h6>
                                <p class="card-text text-danger font-weight-bold mb-2">S/ @item.Precio?.ToString("N2")</p>
                            </div>

                            <div class="card-footer bg-transparent text-center border-0 pt-0">
                                @if (isSoldOut)
                                {
                                    <button class="btn btn-secondary btn-sm px-3" disabled>
                                        <i class="bi bi-x-circle"></i> No disponible
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm px-3">
                                        <i class="bi bi-eye"></i> Ver prenda
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
